# Скопируйте в `.env`. Docker Compose подставляет значения из `.env` автоматически.

# -----------------------------------------------------------------------------
# PostgreSQL (сервис `db` в docker-compose.yml и Spring production)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=myapp

# JDBC при запуске Spring на хосте, когда БД только в Docker (порт проброшен на хост):
DB_URL=jdbc:postgresql://localhost:5433/myapp
DB_USERNAME=postgres
DB_PASSWORD=postgres

# -----------------------------------------------------------------------------
# Docker Compose — порты на хосте
# -----------------------------------------------------------------------------
POSTGRES_HOST_PORT=5433
APP_PORT=8080

# -----------------------------------------------------------------------------
# Локальный `./gradlew bootRun` против compose-БД
# -----------------------------------------------------------------------------
# export SPRING_PROFILES_ACTIVE=production
# (или задайте DB_URL / DB_USERNAME / DB_PASSWORD как выше)

# Первый запуск без миграций: для контейнера `app` уже задано update в compose.
# Для bootRun при пустой БД временно: SPRING_JPA_HIBERNATE_DDL_AUTO=update
