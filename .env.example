# Скопируйте в `.env` и подставьте свои значения.
# Файл `.env` подхватывает Docker Compose для подстановки в docker-compose.yml.
# Для `./gradlew bootRun` с профилем production экспортируйте переменные вручную или используйте dotenv-плагин IDE.

# -----------------------------------------------------------------------------
# PostgreSQL для профиля `production` (application-production.yml)
# -----------------------------------------------------------------------------
# В YAML заданы значения по умолчанию (localhost, postgres/postgres) — Spring
# стартует и без .env. Для реального окружения задайте свои URL и учётные данные.

# JDBC URL (обязательно переопределить в продакшене)
DB_URL=jdbc:postgresql://localhost:5432/myapp

# Пользователь БД
DB_USERNAME=postgres

# Пароль БД (в продакшене — обязательно сменить; не используйте дефолт из примера)
DB_PASSWORD=postgres

# -----------------------------------------------------------------------------
# Docker Compose (docker-compose.yml) — только подстановка портов на хосте
# -----------------------------------------------------------------------------
POSTGRES_HOST_PORT=5433
APP_PORT=8080

# -----------------------------------------------------------------------------
# Опционально: только если поднимаете приложение сами (не из готового compose)
# -----------------------------------------------------------------------------
# SPRING_PROFILES_ACTIVE=production

# Первый запуск без миграций: временно `update`, иначе при ddl-auto=validate
# схема должна уже существовать в БД.
# SPRING_JPA_HIBERNATE_DDL_AUTO=validate
